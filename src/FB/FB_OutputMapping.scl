FUNCTION_BLOCK "FB_OutputMapping"
TITLE = Ausgänge auf die Hardware schreiben
{ S7_Optimized_Access := 'TRUE' }
// Überträgt das Ausgangsabbild der Steuerung (DB_IO.Outputs) auf die Hardware-Ausgänge.
// Im Simulationsbetrieb bleiben alle Hardware-Ausgänge AUS: Falls doch echte Aktoren
// angeschlossen sind, dürfen sie sich nicht durch die Simulation bewegen.
// Die Simulation liest DB_IO.Outputs direkt.
VERSION : 0.1
   VAR_INPUT
      SimMode : Bool;   // TRUE = Simulation, Hardware-Ausgänge bleiben AUS
   END_VAR

   VAR_IN_OUT
      Outputs : "UDT_IoOutputs";   // Ausgangsabbild der Steuerlogik
   END_VAR


BEGIN
	IF #SimMode THEN
	    "qConveyor" := FALSE;
	    "qSorter1" := FALSE;
	    "qSorter2" := FALSE;
	    "qSorter3" := FALSE;
	    "qLampRun" := FALSE;
	    "qLampFault" := FALSE;
	ELSE
	    "qConveyor" := #Outputs.Conveyor;
	    "qSorter1" := #Outputs.SorterExtend[1];
	    "qSorter2" := #Outputs.SorterExtend[2];
	    "qSorter3" := #Outputs.SorterExtend[3];
	    "qLampRun" := #Outputs.LampRun;
	    "qLampFault" := #Outputs.LampFault;
	END_IF;
END_FUNCTION_BLOCK
