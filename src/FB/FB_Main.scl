FUNCTION_BLOCK "FB_Main"
TITLE = Hauptbaustein der Sortieranlage
{ S7_Optimized_Access := 'TRUE' }
// Wird alle 100 ms aus OB30 aufgerufen (Instanz: IDB_Main).
// Feste Reihenfolge pro Durchlauf:
//   1. Simulation     – bewegt Pakete und Sortierer, erzeugt DB_IO.SimInputs
//                       aus den Ausgängen des vorherigen Durchlaufs
//   2. Eingänge       – DB_IO.Inputs aus Simulation oder Hardware
//   3. Steuerlogik    – Anlagenzustand, Band, Paketverfolgung, Sortierung, Alarme, Statistik
//   4. Ausgänge       – DB_IO.Outputs auf die Hardware
// Reihenfolge in Schritt 3: Detection, Sorting und Alarms werten RESET aus,
// danach setzt FB_Plant die HMI-Tasten zurück. FB_Counters zählt zuletzt.
VERSION : 0.1
   VAR
      Simulation : "FB_Simulation";
      InputMapping : "FB_InputMapping";
      Detection : "FB_Detection";
      Sorting : "FB_Sorting";
      Alarms : "FB_Alarms";
      Plant : "FB_Plant";
      Conveyor : "FB_Conveyor";
      Counters : "FB_Counters";
      OutputMapping : "FB_OutputMapping";
   END_VAR


BEGIN
	// 1. Simulation (nur im Simulationsbetrieb)
	IF "DB_IO".SimMode THEN
	    #Simulation(Outputs := "DB_IO".Outputs,
	                SimInputs := "DB_IO".SimInputs);
	END_IF;

	// 2. Eingänge
	#InputMapping(SimMode := "DB_IO".SimMode,
	              SimInputs := "DB_IO".SimInputs,
	              Inputs := "DB_IO".Inputs);

	// 3. Steuerlogik
	//    Paketverfolgung zuerst: rechnet mit dem Bandzustand des vorherigen Durchlaufs,
	//    genau wie die Simulation, und sieht RESET, bevor FB_Plant die Tasten zurücksetzt
	#Detection(BeltRunning := "DB_Plant".Conveyor.Running,
	           ResetErrors := "DB_Hmi".Plant.Reset,
	           Inputs := "DB_IO".Inputs);
	
	#Sorting(PlantState := "DB_Plant".State,
	         ResetFaults := "DB_Hmi".Plant.Reset,
	         Inputs := "DB_IO".Inputs,
	         Outputs := "DB_IO".Outputs);
	
	#Alarms(Reset := "DB_Hmi".Plant.Reset,
	        PackageLost := #Detection.PackageLost,
	        ExitTimeout := #Detection.ExitTimeout,
	        Missort := #Detection.Missort,
	        ScaleFault := #Detection.ScaleFault,
	        Inputs := "DB_IO".Inputs);
	
	#Plant(Inputs := "DB_IO".Inputs,
	       Outputs := "DB_IO".Outputs);
	
	#Conveyor(MotorProtectOk := "DB_IO".Inputs.MotorProtectOk,
	          Conveyor := "DB_Plant".Conveyor,
	          Outputs := "DB_IO".Outputs);
	
	#Counters();

	// 4. Ausgänge
	#OutputMapping(SimMode := "DB_IO".SimMode,
	               Outputs := "DB_IO".Outputs);
END_FUNCTION_BLOCK
