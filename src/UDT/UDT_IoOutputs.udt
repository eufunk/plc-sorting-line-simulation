TYPE "UDT_IoOutputs"
TITLE = Ausgangsabbild der Steuerung
// Geschrieben von der Steuerlogik, von FB_OutputMapping auf %Q übertragen
// und von FB_Simulation gelesen.
// Adressen: docs/Anlagenkonfiguration.md, Abschnitt 5
VERSION : 0.1
   STRUCT
      Conveyor : Bool;   // M1  %Q0.0  Förderband EIN
      SorterExtend : Array[1..3] of Bool;   // Q1..Q3  %Q0.1..%Q0.3  Sortierer ausfahren
      LampRun : Bool;   // H1  %Q0.4  Betriebsleuchte
      LampFault : Bool;   // H2  %Q0.5  Störungsleuchte
   END_STRUCT;

END_TYPE
