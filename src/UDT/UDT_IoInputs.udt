TYPE "UDT_IoInputs"
TITLE = Eingangsabbild der Steuerung
// Gefüllt von FB_InputMapping: aus %I (Hardware) oder aus FB_Simulation (SimMode).
// Die Steuerlogik liest ausschließlich diese Struktur, nie direkt %I.
// Adressen: docs/Anlagenkonfiguration.md, Abschnitt 5
VERSION : 0.1
   STRUCT
      EmergencyStopOk : Bool;   // B1  %I0.0  Not-Halt nicht betätigt (Öffner)
      MotorProtectOk : Bool;   // B2  %I0.1  Motorschutz M1 OK
      Infeed : Bool;   // S1  %I0.2  Paket am Einlauf
      SizeLarge : Bool;   // S2  %I0.3  Paket groß
      Metal : Bool;   // S3  %I0.4  Metall erkannt
      QualityOk : Bool;   // S5  %I0.5  Qualität OK
      SortEntry : Bool;   // S6  %I0.6  Paket am Beginn der Sortierstrecke
      ExitSensor : Array[1..4] of Bool;   // S7..S10  %I0.7..%I1.2  Paket in Ausgang 1..4
      SorterRetracted : Array[1..3] of Bool;   // S11/S13/S15  Sortierer eingefahren
      SorterExtended : Array[1..3] of Bool;   // S12/S14/S16  Sortierer ausgefahren
      WeightRaw : Int;   // S4  %IW64  Waage, 0..27648 = 0..10 kg
   END_STRUCT;

END_TYPE
